# =============================================================================
# File: backend/.env
# Variabel lingkungan untuk mesin lokal (JANGAN commit secret production ke git).
# Di-load oleh: require("dotenv").config() di server.js dan config/db.js
# =============================================================================

# --- MySQL (misalnya XAMPP) ---
# Host tempat MySQL mendengarkan koneksi TCP
DB_HOST=localhost
# User database (root umum di development)
DB_USER=root
# Password user MySQL (default XAMPP sering kosong)
DB_PASS=
# Nama database yang berisi tabel users, kontak, dll.
DB_NAME=toko_online

# --- Server HTTP ---
# Port tempat Express listen; akses API = http://localhost:PORT/...
PORT=5000

# --- JWT ---
# Kunci rahasia untuk menandatangani & memverifikasi token (harus panjang & acak di production)
JWT_SECRET=rahasia_super_aman
