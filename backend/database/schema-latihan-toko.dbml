// =============================================================================
// Latihan toko — diagram untuk dbdiagram.io (DBML)
// Sinkron dengan: schema-latihan-toko.sql
// =============================================================================

Project latihan_toko {
  database_type: 'MySQL'
  Note: '''
    Master: kategori_produk, pengiriman, bank (bukan ENUM).
    produk.kategori & pembelian.pengiriman = VARCHAR (nama dari master).
  '''
}

enum users_role {
  admin
  pembeli
}

enum pembelian_metode_pembayaran {
  "Bank Transfer"
  COD
}

enum pembelian_pembayaran {
  Belum
  Dibayar
}

enum pembelian_status {
  Tertunda
  Dikemas
  Dikirim
  Diterima
  Selesai
}

Table users {
  id int [pk, increment, not null]
  nama_d varchar(50) [not null]
  nama_b varchar(50) [not null]
  kelamin text [not null]
  lahir text [not null]
  alamat text [not null]
  phone bigint [not null]
  email varchar(30) [not null, unique]
  role users_role [not null, default: 'pembeli']
  uname varchar(30) [not null, unique]
  passwd varchar(256) [not null]
  foto varchar(500) [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
}

Table kategori_produk {
  id int [pk, increment]
  nama varchar(100) [not null, unique]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
}

Table pengiriman {
  id int [pk, increment]
  nama varchar(100) [not null, unique]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
}

Table bank {
  id int [pk, increment]
  nama_bank varchar(50) [not null]
  no_rek varchar(50) [not null]
  atas_nama varchar(100) [null, note: 'a.n. pemilik rekening']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
}

Table produk {
  id_produk int [pk, increment, not null]
  nama_produk varchar(255) [not null]
  deskripsi text [not null]
  harga int [not null]
  gambar varchar(500) [null]
  kategori varchar(100) [not null, note: 'nama dari kategori_produk']
  stok int [not null, default: 0]
  aktif tinyint [not null, default: 1, note: '1=tampil di katalog, 0=nonaktif']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
}

Table pembelian {
  id int [pk, increment, not null]
  id_pembeli int [not null, ref: > users.id]
  id_produk int [not null, ref: > produk.id_produk]
  nama_pembeli varchar(50) [null]
  alamat_pembeli text [null]
  phone_pembeli bigint [null]
  metode_pembayaran pembelian_metode_pembayaran [not null, default: 'COD']
  pembayaran pembelian_pembayaran [not null, default: 'Belum']
  pengiriman varchar(100) [not null, note: 'nama dari tabel pengiriman']
  status pembelian_status [not null, default: 'Tertunda']
  catatan text [null]
  foto_bukti varchar(500) [null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
}

Table artikel {
  id int [pk, increment]
  judul varchar(225) [not null]
  ringkasan text [not null]
  isi text [not null]
  gambar varchar(500) [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
}

Table kontak {
  id int [pk, increment]
  nama_lengkap varchar(50) [not null]
  email varchar(30) [not null]
  no_hp bigint [not null]
  isi_pesan text [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
}

Table info_toko {
  logo_toko varchar(500) [not null]
  nama_toko varchar(50) [not null]
  tentang text [not null]
  foto_banner varchar(500) [not null]
  alamat_toko text [not null]
  email_toko varchar(30) [not null]
  tlp_toko bigint [not null]
  jam_buka int [not null]
  jam_tutup int [not null]
  logo_wa varchar(500) [not null]
  logo_ig varchar(500) [not null]
  logo_fb varchar(500) [not null]
  link_wa text [not null]
  link_ig text [not null]
  link_fb text [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  Note: 'Rekening bank ada di tabel bank, bukan di sini'
}
